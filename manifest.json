{
  "manifest_version": 3,

  "name": "AutoApplyr",
  "version": "1.0.0",

  "description": "Automatically applies to LinkedIn job offers.",

  "permissions": [
    "activeTab", "scripting","tabs","storage","cookies"
  ],

  "host_permissions": [
    "https://*.linkedin.com/*"
  ],

  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*"
      ],
      "js": [
        "index.js"
      ],
      "run_at": "document_idle"
    }
  ]
}